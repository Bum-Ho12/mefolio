# Copy to .env.local and fill in. See README.md for what each group does.

# --- Required: public site ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-07
# Canonical origin, no trailing slash. Used for metadataBase, robots.txt, sitemap.xml and share images.
# Falls back to the Vercel production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Optional: content admin (/admin). All of these must be set or /admin returns 404 ---
ADMIN_ENABLED=
ADMIN_GITHUB_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_VERSION=1
ADMIN_BASE_URL=
SANITY_WRITE_TOKEN=

# --- Optional: Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mefolio
